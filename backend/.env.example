# FastAPI server settings
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite persistence path (relative to backend/ or absolute)
DATABASE_PATH=data/email_agent.db

# LLM Configuration: mock | openai | gemini | openai_compatible
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_ALLOW_MOCK_FALLBACK=true
