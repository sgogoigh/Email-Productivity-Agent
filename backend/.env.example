# FastAPI server settings
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database connectivity: SQLite (default WAL mode) or PostgreSQL via DATABASE_URL
# Example PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/email_agent
DATABASE_PATH=data/email_agent.db
DATABASE_URL=

# Structured logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/backend.log

# LLM Configuration: mock | openai | gemini | openai_compatible
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_ALLOW_MOCK_FALLBACK=true
